# Copy to .env and replace placeholders. Never commit your .env.
# Optional absolute upload directory; defaults to repository data/uploads/complaints.
# UPLOAD_DIR=C:/path/to/civicai-uploads
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/civicai
# Dedicated disposable test database; must differ from DATABASE_URL and end in _test.
TEST_DATABASE_URL=postgresql+psycopg://YOUR_TEST_USER:YOUR_TEST_PASSWORD@127.0.0.1:5432/civicai_test

# Issue-location search. Public Nominatim is suitable only for this low-volume local demo.
# Use an identifying value and configure a managed/self-hosted provider before deployment.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=CivicAI-MCA/0.1 educational-local-prototype
GEOCODING_COUNTRY_CODES=in
