# Leave empty when using the Vite development proxy.
# Set this to the deployed backend origin when the frontend is hosted separately.
VITE_API_BASE_URL=

# Optional MapLibre style URL. The default MapLibre demo style is for local demonstration only.
# Configure a compliant managed/self-hosted style and tiles source before deployment.
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
