# Leave empty when using the Vite development proxy.
# Set this to the deployed backend origin when the frontend is hosted separately.
VITE_API_BASE_URL=

# Browser-public MapTiler key for Leaflet Streets v4 tiles. This value is compiled
# into JavaScript and is not a secret. It may equal the backend key on a one-key
# plan; restrict it by Allowed HTTP Origins in MapTiler. There is no anonymous fallback.
VITE_MAPTILER_API_KEY=
