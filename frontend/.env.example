# Leave empty when using the Vite development proxy.
# Set this to the deployed backend origin when the frontend is hosted separately.
VITE_API_BASE_URL=

# Optional Leaflet raster-tile template. The default is for modest interactive local-demo use only.
# Configure a managed/self-hosted tile provider with suitable terms and availability before production.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
