FROM node:22.12.0-alpine AS frontend-build
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
ARG VITE_MAPTILER_API_KEY
RUN node -e "if (!process.env.VITE_MAPTILER_API_KEY) { throw new Error('VITE_MAPTILER_API_KEY is required') }"
ENV VITE_MAPTILER_API_KEY=$VITE_MAPTILER_API_KEY VITE_API_BASE_URL=
RUN npm run build

FROM caddy:2.10.2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=frontend-build /src/frontend/dist /srv
