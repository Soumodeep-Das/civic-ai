{
  "version": "civicai-exploratory-ai-labels-v1",
  "status": "local_exploratory_fit_authorized_not_operational_release",
  "training_approved": false,
  "evaluation_holdout": false,
  "target": "single_known_service_family_on_described_issue_records",
  "planning_min_components_per_family": 18,
  "planning_floor_meaning": "Deadline pilot engineering scope; 18 groups is not statistical sufficiency. Revised before fitting; independent protocol unchanged.",
  "same_family_multiple_components": "retain_as_one_complaint",
  "cross_family_or_ambiguous_records": "defer_with_reported_counts_never_force_other",
  "pilot_role": "development_and_definition_only_never_final_test",
  "features": "privacy_reviewed_complaint_text_only",
  "forbidden_features": [
    "source_labels",
    "AI_rationales",
    "annotation_offsets",
    "record_ids",
    "source_groups",
    "coordinates",
    "outcomes",
    "privacy_flags"
  ],
  "preprocessing": "deterministic_approved_redaction_then_train_fold_only_TFIDF_preserve_negation",
  "baseline": "DummyClassifier_most_frequent",
  "model": "TFIDF_word_1_2_grams_plus_LogisticRegression",
  "tfidf": {
    "lowercase": true,
    "strip_accents": null,
    "stop_words": null,
    "min_df": 1,
    "max_df": 1.0,
    "max_features": 20000,
    "sublinear_tf": true
  },
  "logistic_regression": {
    "solver": "lbfgs",
    "C": [
      0.1,
      1.0,
      10.0
    ],
    "class_weight": [
      null,
      "balanced"
    ],
    "max_iter": 2000
  },
  "development_validation": {
    "method": "StratifiedGroupKFold",
    "n_splits": 3,
    "shuffle": true,
    "random_state": 42,
    "require_all_selected_classes_in_each_train_and_validation_fold": true,
    "on_infeasibility": "stop_and_revise_protocol_before_fitting"
  },
  "selection": "mean_group_fold_macro_F1_then_smaller_C_then_no_class_weight",
  "metrics": [
    "macro_F1_fixed_label_order_zero_division_0",
    "per_class_precision_recall_F1_and_support",
    "confusion_matrix",
    "balanced_accuracy",
    "record_and_group_coverage",
    "deferred_case_counts"
  ],
  "independent_test": "fresh_reference_adjudicated_groups_disjoint_from_all_pilot_and_development_components_frozen_before_fitting_final_model",
  "test_support_planning_floor_per_class": 20,
  "test_floor_meaning": "Minimum descriptive pilot-test planning count in independent groups, not a power calculation or production certificate",
  "test_uncertainty": "reference_class_stratified_group_bootstrap_2000_seed_42_report_95_percent_intervals_not_record_bootstrap",
  "abstention": "no_probability_or_confidence_claim_initial_baseline_report_closed_set_predictions_only_on_eligible_scope",
  "challenge_set": "independently_reviewed_mixed_unclear_unsupported_language_and_out_of_scope_records_report_separately_no_forced_ground_truth",
  "AI_label_experiment": "requires_separate_disclosed_weak_supervision_protocol_cannot_replace_independent_reference_evaluation",
  "operational_release": "disabled_no_automatic_routing_severity_priority_or_public_predictions",
  "required_run_record": [
