APP_ENV=production
RELEASE_ID=replace-with-git-commit-sha
LOG_LEVEL=INFO
CIVICAI_SITE_ADDRESS=civicai.example.org
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
PUBLIC_TRACKING_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_NAME=civicai_session
AUTH_SESSION_HOURS=8
AUTH_ALLOWED_ORIGINS=https://civicai.example.org
PUBLIC_BASE_URL=https://civicai.example.org
AUTH_VERIFICATION_MINUTES=60
AUTH_RESET_MINUTES=30
AUTH_INVITATION_HOURS=72
# Configure a real SMTP provider for verification, reset and staff invitation mail.
EMAIL_TRANSPORT=smtp
EMAIL_FROM=no-reply@civicai.example.org
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_STARTTLS=true
# Google OAuth web-client credentials; callback must exactly match Google Cloud.
GOOGLE_OIDC_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_OIDC_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_OIDC_REDIRECT_URI=https://civicai.example.org/api/v1/citizen-auth/google/callback
GEOCODING_PROVIDER=maptiler
# Backend geocoding credential. With a one-key MapTiler plan, this same key is
# also compiled into the browser by the Compose fallback below and is public.
MAPTILER_API_KEY=REPLACE_WITH_MAPTILER_KEY
MAPTILER_BASE_URL=https://api.maptiler.com
# Compose derives MAPTILER_REQUEST_ORIGIN=https://CIVICAI_SITE_ADDRESS.
GEOCODING_COUNTRY_CODES=in
GEOCODING_PROXIMITY=88.3639,22.5726
# Optional override for plans that permit a distinct browser key. Leave empty to
# reuse MAPTILER_API_KEY. Any key used here/in the browser is publicly observable.
VITE_MAPTILER_API_KEY=
