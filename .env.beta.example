# Public deployment identity (replace example host after Render creates it)
APP_ENV=beta
RELEASE_ID=render-beta
PUBLIC_BASE_URL=https://civicai-beta.example.onrender.com
AUTH_ALLOWED_ORIGINS=https://civicai-beta.example.onrender.com
AUTH_COOKIE_SECURE=true
PUBLIC_TRACKING_SECRET=generate-a-unique-random-value-at-least-32-bytes

# Supabase shared pooler session-mode URL. Secret: contains the database password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:DATABASE_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300

# Private Supabase Storage S3 adapter. Access and secret keys are server-only secrets.
EVIDENCE_STORAGE_BACKEND=s3
EVIDENCE_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
EVIDENCE_S3_REGION=PROJECT_REGION
EVIDENCE_S3_BUCKET=civicai-complaint-evidence
EVIDENCE_S3_ACCESS_KEY_ID=server-only-s3-access-key
EVIDENCE_S3_SECRET_ACCESS_KEY=server-only-s3-secret-key

# Email over HTTPS (Render blocks outbound SMTP ports).
EMAIL_TRANSPORT=brevo
EMAIL_FROM=verified-sender@example.com
BREVO_API_KEY=server-only-brevo-api-key

# MapTiler backend key is secret-ish; VITE key is compiled and publicly observable.
GEOCODING_PROVIDER=maptiler
MAPTILER_API_KEY=server-maptiler-key
VITE_MAPTILER_API_KEY=public-origin-restricted-maptiler-key
MAPTILER_REQUEST_ORIGIN=https://civicai-beta.example.onrender.com

# Existing Google web OAuth client. Secret stays server-side.
GOOGLE_OIDC_CLIENT_ID=google-client-id.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=server-only-google-client-secret
GOOGLE_OIDC_REDIRECT_URI=https://civicai-beta.example.onrender.com/api/v1/citizen-auth/google/callback


